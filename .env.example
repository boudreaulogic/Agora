# ==============================================================================
# Agora — Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# For Docker deployment (default):
DATABASE_URL="postgresql://agora:changeme@postgres:5432/agora?schema=public"
POSTGRES_PASSWORD="changeme"

# For local development (no Docker):
# DATABASE_URL="postgresql://agora:changeme@localhost:5432/agora?schema=public"

# ------------------------------------------------------------------------------
# NEXTAUTH
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# ENCRYPTION
# ------------------------------------------------------------------------------
# Used for encrypting SMTP credentials and sensitive data at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="generate-a-64-char-hex-key-here"

# ------------------------------------------------------------------------------
# WEBSOCKET SERVER
# ------------------------------------------------------------------------------
# Secret for authenticating broadcast messages between Next.js and WS server
# Generate with: openssl rand -hex 32
BROADCAST_SECRET="generate-a-random-secret-here"

# WebSocket URL (client-side) — set if using a custom domain
# NEXT_PUBLIC_WS_URL="wss://ws.yourdomain.com"

# ------------------------------------------------------------------------------
# EMAIL (SMTP) — Optional
# ------------------------------------------------------------------------------
# Configure via Admin Panel > SMTP Settings after first login
# Or set here for Docker deployment:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@yourdomain.com"

# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
